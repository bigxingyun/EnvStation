<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EnvStation.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  XamlControlsResources 必须在最前：它是 WinUI 3 控件默认样式的基础，
                  后面的令牌字典覆盖其中的颜色与排版键。
                -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!--
                  设计令牌（唯一源头 design/xaml/）不在这里合并，而是由 App.xaml.cs 在
                  InitializeComponent 之后用代码合并。原因是实测出来的：
                  XBF 里 Source 会被写成普通字符串，运行期报
                  「Failed to assign to property 'ResourceDictionary.Source' because the type
                  'Windows.Foundation.String' cannot be assigned to the type 'Windows.Foundation.Uri'」
                  并直接崩在启动阶段——因为 design/xaml/*.xaml 是链接进来的 Content，
                  不是本工程的 Page，XAML 编译器没有把它们编译成 XBF，也就不会生成 Uri 引用。
                  代码里 new Uri(...) 显式赋值同样绕开了这个转换。细节见 实施进展与M0结论.md。
                -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
