<!--
    环境站 EnvStation — 排版令牌（M3 Type Scale 15 级 + 4 个等宽扩展）

    来源：design/tokens.json → typeScale / monoScale
    桌面档行高（hhd 字段）为**默认值**：本项目采用 M3 桌面密度档（见 UI设计规范 2.5.0 节）。

    用法：
        <TextBlock Style="{StaticResource Type.TitleMedium}" Text="卡片标题" />
        <TextBlock Style="{StaticResource Type.MonoBody}" Text="D:\Dev\Python" />

    为什么用 Style 而不是只给 FontSize：
      M3 的每一级都是"字号 + 行高 + 字重 + 字距"四元组，四者缺一都会破坏层级节奏
      （FT-8）。把它们封成 Style 可以避免各处临时覆写 LineHeight 导致密度不一致。

    注意：WinUI 的 CharacterSpacing 单位是 1/1000 em，而 tokens.json 中 tracking 的单位是 px。
    转换规则：CharacterSpacing = tracking(px) / fontSize(px) * 1000，四舍五入到整数。
    该换算已在本文件中完成（见每行注释）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════ 字体族 ═══════════════════ -->

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, JetBrains Mono, Consolas, Courier New</FontFamily>

    <!-- ═══════════════════ M3 Display ═══════════════════ -->

    <!-- 57px / 56px / 400 / -0.25px → CharacterSpacing -4 -->
    <Style x:Key="Type.DisplayLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="57" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="-4" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 45px / 46px / 400 / 0 → 0 -->
    <Style x:Key="Type.DisplayMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="45" />
        <Setter Property="LineHeight" Value="46" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 36px / 40px / 400 / 0 → 0 -->
    <Style x:Key="Type.DisplaySmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ═══════════════════ M3 Headline ═══════════════════ -->

    <!-- 32px / 36px -->
    <Style x:Key="Type.HeadlineLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <!-- 28px / 32px -->
    <Style x:Key="Type.HeadlineMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <!-- 24px / 28px —— 体检结论标题、空态主标题 -->
    <Style x:Key="Type.HeadlineSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <!-- ═══════════════════ M3 Title ═══════════════════ -->

    <!-- 22px / 24px —— 页面标题（顶部栏） -->
    <Style x:Key="Type.TitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 16px / 20px / 500 / 0.15px → 9 -->
    <Style x:Key="Type.TitleMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="9" />
    </Style>

    <!-- 14px / 18px / 500 / 0.1px → 7 -->
    <Style x:Key="Type.TitleSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="7" />
    </Style>

    <!-- ═══════════════════ M3 Body ═══════════════════ -->

    <!-- 16px / 22px / 0.5px → 31 -->
    <Style x:Key="Type.BodyLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="31" />
    </Style>

    <!-- 14px / 18px / 0.25px → 18 —— 正文默认样式 -->
    <Style x:Key="Type.BodyMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="18" />
    </Style>

    <!-- 12px / 16px / 0.4px → 33 -->
    <Style x:Key="Type.BodySmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="33" />
    </Style>

    <!-- ═══════════════════ M3 Label ═══════════════════ -->

    <!-- 14px / 18px / 500 / 0.1px → 7 —— 按钮文案 -->
    <Style x:Key="Type.LabelLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="7" />
    </Style>

    <!-- 12px / 16px / 500 / 0.5px → 42 —— Chip 文案 -->
    <Style x:Key="Type.LabelMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="42" />
    </Style>

    <!-- 11px / 14px / 500 / 0.5px → 45 —— 大写小标签、徽标 -->
    <Style x:Key="Type.LabelSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="45" />
    </Style>

    <!-- ═══════════════════ 产品扩展：等宽技术值 ═══════════════════
         使用边界见 UI设计规范 FT-1：路径、版本、命令、哈希、注册表键、环境变量名、日志、代码片段。
         刻意**不加** CharacterSpacing：等宽字形的设计宽度已固定，再加字距会破坏对齐。 -->

    <!-- 13px / 18px -->
    <Style x:Key="Type.MonoBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 12px / 16px —— 表格内技术值 -->
    <Style x:Key="Type.MonoSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 12px / 16px —— 日志面板。刻意 NoWrap：日志靠横向滚动保持时间戳列对齐 -->
    <Style x:Key="Type.MonoLog" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 11px / 14px / 600 —— 快捷键提示 -->
    <Style x:Key="Type.MonoKbd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <!-- ═══════════════════ 语义文本样式（组合排版 + 颜色） ═══════════════════
         这些样式把"排版层级 + 前景色语义"一起封装，避免每个页面重复写 Foreground。 -->

    <Style x:Key="Text.Primary" TargetType="TextBlock" BasedOn="{StaticResource Type.BodyMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurface}" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Type.BodyMedium}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariant}" />
    </Style>

    <Style x:Key="Text.Meta" TargetType="TextBlock" BasedOn="{StaticResource Type.BodySmall}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariant}" />
    </Style>

    <Style x:Key="Text.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Type.LabelSmall}">
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariant}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 技术值：等宽 + 技术色。三种着色按语义区分（路径 / 版本 / 命令） -->
    <Style x:Key="Text.Tech" TargetType="TextBlock" BasedOn="{StaticResource Type.MonoBody}">
        <Setter Property="Foreground" Value="{ThemeResource TechText}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="Text.TechPath" TargetType="TextBlock" BasedOn="{StaticResource Type.MonoBody}">
        <Setter Property="Foreground" Value="{ThemeResource TechPath}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="Text.TechVersion" TargetType="TextBlock" BasedOn="{StaticResource Type.MonoBody}">
        <Setter Property="Foreground" Value="{ThemeResource TechVersion}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="Text.TechCommand" TargetType="TextBlock" BasedOn="{StaticResource Type.MonoBody}">
        <Setter Property="Foreground" Value="{ThemeResource TechCommand}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

</ResourceDictionary>
